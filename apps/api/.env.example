# Copy to .env (apps/api/.env) for local development outside Docker.
# Inside Docker, env vars come from the top-level docker-compose.yml.

NEXUS_ENVIRONMENT=dev
NEXUS_LOG_LEVEL=INFO
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus
NEXUS_REDIS_URL=redis://localhost:6379/0

# Auth (admin endpoints + Better Auth handoff in block G)
NEXUS_ADMIN_TOKEN=dev-admin-token-change-me

# YCloud — Phase 1 BSP for WhatsApp
# Real values live in apps/api/.env.local (gitignored).
NEXUS_YCLOUD_API_KEY=replace-me
NEXUS_YCLOUD_WEBHOOK_SECRET=replace-me
NEXUS_YCLOUD_API_BASE_URL=https://api.ycloud.com/v2

# Operator fallback (E.164) — receives ``alert_*`` templates if a tenant
# does not have ``tenants.owner_phone`` set yet. In Phase 1 this is Lee.
NEXUS_OPERATOR_FALLBACK_PHONE=
