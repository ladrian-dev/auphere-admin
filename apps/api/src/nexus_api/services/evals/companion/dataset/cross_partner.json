{
  "family": "cross_partner",
  "description": "Familia 3 — garantía C1: el cliente de otro partner no existe. El fallo tiene que ser el MISMO 404 opaco que el de una referencia inexistente, byte a byte. Si se distinguieran, el Companion sería un oráculo para averiguar la cartera de la competencia probando referencias. Todos estos casos corren en verde hoy: el camino de lectura de CO-02 ya existe.",
  "cases": [
    {
      "id": "f3-get-client-ajeno",
      "family": "cross_partner",
      "title": "La ficha del cliente de otro partner no existe",
      "user_message": "Enséñame la ficha de $b.ref",
      "principal": "a",
      "trajectory": [
        {
          "tool": "console.get_client",
          "args": {
            "client_ref": "$b.ref"
          }
        },
        {
          "text": "No encuentro ningún cliente con esa referencia en tu cartera."
        }
      ],
      "expect": {
        "reads_ok": 0,
        "tool_error_code": "unknown_client",
        "opaque_as_missing": true,
        "unsupported": false
      }
    },
