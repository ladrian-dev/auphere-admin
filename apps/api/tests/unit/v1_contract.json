  "/v1/partners/clients/{external_client_ref}/admins": {
    "get": {
      "body": {},
      "params": [
        [
          "Authorization",
          "header",
          false
        ],
        [
          "external_client_ref",
          "path",
          true
        ]
      ],
      "responses": [
        "200",
        "400",
        "401",
        "403",
        "422",
        "429"
      ]
    },
    "put": {
      "body": {
        "content": {
          "application/json": {
            "schema": {
              "additionalProperties": false,
              "properties": {
                "admins": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "anyOf": [
                          {
                            "maxLength": 120,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "phone": {
                        "maxLength": 32,
                        "minLength": 4,
                        "type": "string"
                      },
                      "role": {
                        "default": "full",
                        "enum": [
                          "full",
                          "readonly"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "phone"
                    ],
                    "type": "object"
                  },
                  "maxItems": 50,
                  "minItems": 0,
                  "type": "array"
                }
              },
              "required": [
                "admins"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "params": [
        [
          "Authorization",
          "header",
          false
        ],
        [
          "external_client_ref",
          "path",
          true
        ]
      ],
      "responses": [
        "200",
        "400",
        "401",
        "403",
        "422",
        "429"
      ]
    }
  },
