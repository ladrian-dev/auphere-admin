  "/v1/partners/clients/{external_client_ref}/whatsapp/signup": {
    "post": {
      "body": {
        "content": {
          "application/json": {
            "schema": {
              "additionalProperties": false,
              "properties": {
                "business_id": {
                  "anyOf": [
                    {
                      "maxLength": 64,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "code": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "mode": {
                  "default": "coexistence",
                  "pattern": "^(cloud_api|coexistence)$",
                  "type": "string"
                },
                "phone_number_id": {
                  "anyOf": [
                    {
                      "maxLength": 64,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "waba_id": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "code",
                "waba_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "params": [
        [
          "Authorization",
          "header",
          false
        ],
        [
          "external_client_ref",
          "path",
          true
        ]
      ],
      "responses": [
        "201",
        "400",
        "401",
        "403",
        "422",
        "429"
      ]
    }
  },
