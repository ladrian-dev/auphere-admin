{
  "/v1/messages/template": {
    "post": {
      "body": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "channel_id": {
                  "anyOf": [
                    {
                      "format": "uuid",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "idempotency_key": {
                  "anyOf": [
                    {
                      "maxLength": 80,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "language": {
                  "default": "es",
                  "maxLength": 16,
                  "type": "string"
                },
                "template_name": {
                  "maxLength": 512,
                  "type": "string"
                },
                "to": {
                  "maxLength": 40,
                  "type": "string"
                },
                "variables": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "required": [
                "to",
                "template_name"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "params": [
        [
          "Authorization",
          "header",
          false
        ]
      ],
      "responses": [
        "202",
        "400",
        "401",
        "403",
        "422",
        "429"
      ]
    }
  },
  "/v1/messages/{message_id}": {
    "get": {
      "body": {},
      "params": [
        [
          "Authorization",
          "header",
          false
        ],
        [
          "message_id",
          "path",
          true
        ]
      ],
      "responses": [
        "200",
        "400",
        "401",
        "403",
        "422",
        "429"
      ]
    }
  },
  "/v1/partners/clients": {
    "post": {
      "body": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "agent": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "placeholders": {
                          "additionalProperties": true,
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "connector": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "credentials": {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "minProperties": 1,
                          "type": "object"
                        },
                        "meta": {
                          "additionalProperties": true,
                          "type": "object"
                        }
                      },
                      "required": [
                        "credentials"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "external_client_ref": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                "timezone": {
                  "default": "UTC",
                  "maxLength": 64,
                  "type": "string"
                }
              },
              "required": [
                "external_client_ref",
                "name"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "params": [
        [
          "Authorization",
          "header",
          false
        ]
      ],
      "responses": [
        "200",
        "400",
        "401",
        "403",
        "409",
        "422",
        "429"
      ]
    }
  },
  "/v1/partners/clients/{external_client_ref}": {
    "get": {
      "body": {},
      "params": [
        [
          "Authorization",
          "header",
