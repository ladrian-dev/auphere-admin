 "billing.list_overdue": {
  "description": "List the tenant's accounts-receivable (debts) from Amigable Cobro, one page at a time. Use to drive a collections campaign or review who owes money. By default returns only accounts with a pending balance. Inspect has_more / last_page to decide whether to request another page.",
  "destructive": false,
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "only_with_balance": {
     "default": true,
     "description": "Si true, devuelve solo cuentas con saldo pendiente (>0).",
     "title": "Only With Balance",
     "type": "boolean"
    },
    "page": {
     "default": 1,
     "description": "Página a consultar (empieza en 1).",
     "minimum": 1,
     "title": "Page",
     "type": "integer"
    },
    "status": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Filtro opcional por estado exacto (ej. 'PENDING'). Case-insensitive.",
     "title": "Status"
    }
   },
   "title": "ListOverdueInput",
   "type": "object"
  },
  "output_schema": {
   "$defs": {
    "DebtRecord": {
     "additionalProperties": false,
     "description": "One accounts-receivable record from Amigable Cobro.",
     "properties": {
      "balance": {
