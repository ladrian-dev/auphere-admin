       "title": "Client Document"
      },
      "client_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Nombre del deudor.",
       "title": "Client Name"
      },
      "client_phone": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Teléfono del deudor (E.164).",
       "title": "Client Phone"
      },
      "created_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Fecha de creación (ISO 8601).",
       "title": "Created At"
      },
      "due_date": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Fecha de vencimiento (ISO 8601) o null.",
       "title": "Due Date"
      },
      "id": {
       "description": "ID interno de la cuenta por cobrar en Amigable Cobro.",
       "title": "Id",
       "type": "integer"
      },
      "paid_amount": {
       "description": "Monto pagado hasta ahora.",
       "title": "Paid Amount",
       "type": "number"
      },
      "status": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Estado de la cuenta (ej. PENDING).",
       "title": "Status"
      },
      "total_amount": {
       "description": "Monto total de la deuda.",
       "title": "Total Amount",
       "type": "number"
      }
     },
     "required": [
      "id",
      "total_amount",
      "paid_amount",
      "balance"
