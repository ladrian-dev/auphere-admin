  "reservas.create": {
    "description": "Book for the person you are talking to, at a time find_slots returned. You cannot book for anyone else. Idempotent by idempotency_key. If refused is 'too_large', the group is above what you may book: escalate to a person. Confirm the booking to the customer only when booking is returned.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "any_staff": {
          "default": false,
          "title": "Any Staff",
          "type": "boolean"
        },
        "conversation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "idempotency_key": {
          "description": "Stable for this request: repeating it returns the same booking instead of a second one, e.g. 'reserva:{date}:{time}'.",
          "maxLength": 120,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "join_waitlist": {
          "default": false,
          "description": "Services: also notify them if an earlier slot frees up.",
          "title": "Join Waitlist",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "party_size": {
          "default": 1,
          "maximum": 500,
          "minimum": 1,
          "title": "Party Size",
          "type": "integer"
        },
        "service_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        },
        "staff_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staff Id"
        },
        "time": {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "date",
        "time",
        "idempotency_key"
      ],
      "title": "CreateInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "BookingBrief": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "format": "date",
              "title": "Date",
              "type": "string"
            },
            "end": {
              "title": "End",
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "party_size": {
              "title": "Party Size",
              "type": "integer"
            },
            "service_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Service Name"
            },
            "staff_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Staff Name"
            },
            "start": {
              "title": "Start",
              "type": "string"
            },
            "starts_at": {
              "format": "date-time",
              "title": "Starts At",
              "type": "string"
            },
            "status": {
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "date",
            "start",
            "end",
            "starts_at",
            "party_size"
          ],
          "title": "BookingBrief",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "booking": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookingBrief"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "first_fit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Fit"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "refused": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "slot_taken | too_large | too_soon | too_far | closed | hours_missing. too_large: escalate to a person with escalate.escalate_to_human.",
          "title": "Refused"
        }
      },
      "title": "CreateOutput",
      "type": "object"
    },
    "side_effects": [
      "mutates_db"
    ]
  },
  "reservas.find_slots": {
    "description": "Free times on a day, only within the business's opening hours and its rules. Services mode: pass service_id (and staff_id, or omit for anyone). Capacity mode: pass party_size. Offer only the returned times; if closed or empty, say so and suggest first_fit or another day.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Business-local day to search.",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "party_size": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capacity mode.",
          "title": "Party Size"
        },
        "service_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Services mode: the service.",
          "title": "Service Id"
        },
        "staff_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Services mode: a team member, or omit for anyone.",
          "title": "Staff Id"
        }
      },
      "required": [
        "date"
      ],
      "title": "FindSlotsInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "SlotOut": {
          "additionalProperties": false,
          "properties": {
            "left": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Left"
            },
            "staff": {
              "items": {
                "$ref": "#/$defs/StaffRef"
              },
              "title": "Staff",
              "type": "array"
            },
            "time": {
              "title": "Time",
              "type": "string"
            }
          },
          "required": [
            "time"
          ],
          "title": "SlotOut",
          "type": "object"
        },
        "StaffRef": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "title": "StaffRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "closed": {
          "title": "Closed",
          "type": "boolean"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "first_fit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Fit"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/SlotOut"
          },
          "title": "Slots",
          "type": "array"
        },
        "why_closed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Closed"
        }
      },
      "required": [
        "date",
        "closed"
      ],
      "title": "FindSlotsOutput",
      "type": "object"
    },
    "side_effects": []
  },
