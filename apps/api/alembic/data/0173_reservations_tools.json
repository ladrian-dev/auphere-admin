  "reservas.answer_offer": {
    "description": "The person answers a waitlist offer we sent them (yes or no). Resolves their open offer; never name one. result 'booked' means it is theirs; 'late_taken' means someone else took it first and they stay on the list.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "accept": {
          "title": "Accept",
          "type": "boolean"
        },
        "conversation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        }
      },
      "required": [
        "accept"
      ],
      "title": "AnswerOfferInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "BookingBrief": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "format": "date",
              "title": "Date",
              "type": "string"
            },
            "end": {
              "title": "End",
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "party_size": {
              "title": "Party Size",
              "type": "integer"
            },
            "service_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Service Name"
            },
            "staff_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Staff Name"
            },
            "start": {
              "title": "Start",
              "type": "string"
            },
            "starts_at": {
              "format": "date-time",
              "title": "Starts At",
              "type": "string"
            },
            "status": {
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "date",
            "start",
            "end",
            "starts_at",
            "party_size"
          ],
          "title": "BookingBrief",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "booking": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookingBrief"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "AnswerOfferOutput",
      "type": "object"
    },
    "side_effects": [
      "mutates_db"
    ]
  },
