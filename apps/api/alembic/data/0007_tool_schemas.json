{
  "booking.cancel_appointment": {
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "appointment_id": {
          "format": "uuid",
          "title": "Appointment Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "appointment_id"
      ],
      "title": "CancelAppointmentInput",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "appointment_id": {
          "format": "uuid",
          "title": "Appointment Id",
          "type": "string"
        },
        "status": {
          "const": "cancelled",
          "title": "Status",
          "type": "string"
        },
        "fee_pct": {
          "description": "Cancellation fee percentage applied per tenant policy.",
          "maximum": 100,
          "minimum": 0,
          "title": "Fee Pct",
          "type": "integer"
        }
      },
      "required": [
        "appointment_id",
        "status",
        "fee_pct"
      ],
      "title": "CancelAppointmentOutput",
      "type": "object"
    }
  },
  "booking.check_availability": {
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "on_date": {
          "description": "Date to check (ISO YYYY-MM-DD), interpreted in the tenant's timezone.",
          "format": "date",
          "title": "On Date",
          "type": "string"
        },
        "service_name": {
          "description": "Service the customer wants \u2014 must match a service known to the tenant.",
          "maxLength": 120,
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "barber_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional preferred barber. Omit to consider any barber.",
          "title": "Barber Id"
        },
        "duration_min": {
          "default": 30,
          "description": "Service duration in minutes. Default 30.",
          "maximum": 480,
          "minimum": 5,
          "title": "Duration Min",
          "type": "integer"
        }
      },
      "required": [
        "on_date",
        "service_name"
      ],
      "title": "CheckAvailabilityInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AvailableSlot": {
          "additionalProperties": false,
          "properties": {
            "starts_at": {
              "format": "date-time",
              "title": "Starts At",
              "type": "string"
            },
            "ends_at": {
              "format": "date-time",
              "title": "Ends At",
              "type": "string"
            },
            "barber_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Barber Id"
            }
          },
          "required": [
            "starts_at",
            "ends_at",
            "barber_id"
          ],
          "title": "AvailableSlot",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "on_date": {
          "format": "date",
          "title": "On Date",
          "type": "string"
        },
        "service_name": {
          "title": "Service Name",
          "type": "string"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/AvailableSlot"
          },
          "title": "Slots",
          "type": "array"
        }
      },
      "required": [
        "on_date",
        "service_name",
        "slots"
      ],
      "title": "CheckAvailabilityOutput",
      "type": "object"
    }
  },
  "booking.create_appointment": {
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "format": "uuid",
          "title": "Customer Id",
          "type": "string"
        },
        "service_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "duration_min": {
          "default": 30,
          "maximum": 480,
          "minimum": 5,
          "title": "Duration Min",
          "type": "integer"
        },
        "barber_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barber Id"
        },
        "price_cents": {
          "default": 0,
          "minimum": 0,
          "title": "Price Cents",
          "type": "integer"
        },
        "currency": {
          "default": "CLP",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "idempotency_key": {
          "description": "Caller-supplied idempotency token. Two ``create_appointment`` calls with the same key for the same tenant return the SAME row, never two separate appointments. Required to avoid double-booking on webhook retries.",
          "maxLength": 120,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "customer_id",
        "service_name",
        "starts_at",
        "idempotency_key"
      ],
      "title": "CreateAppointmentInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AppointmentBrief": {
          "additionalProperties": false,
          "properties": {
            "appointment_id": {
              "format": "uuid",
              "title": "Appointment Id",
              "type": "string"
            },
            "starts_at": {
              "format": "date-time",
              "title": "Starts At",
              "type": "string"
            },
            "ends_at": {
              "format": "date-time",
              "title": "Ends At",
              "type": "string"
            },
            "service_name": {
              "title": "Service Name",
              "type": "string"
            },
            "barber_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Barber Id"
            },
            "status": {
              "title": "Status",
              "type": "string"
            },
            "price_cents": {
              "title": "Price Cents",
              "type": "integer"
            },
            "currency": {
              "title": "Currency",
              "type": "string"
            }
          },
          "required": [
            "appointment_id",
            "starts_at",
            "ends_at",
            "service_name",
            "barber_id",
            "status",
            "price_cents",
            "currency"
          ],
          "title": "AppointmentBrief",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "appointment": {
          "$ref": "#/$defs/AppointmentBrief"
        },
        "idempotent_replay": {
          "description": "True if a prior call with the same idempotency_key already created this row.",
          "title": "Idempotent Replay",
          "type": "boolean"
        }
      },
      "required": [
        "appointment",
        "idempotent_replay"
      ],
      "title": "CreateAppointmentOutput",
      "type": "object"
    }
  },
  "booking.get_appointments": {
    "input_schema": {
      "additionalProperties": false,
