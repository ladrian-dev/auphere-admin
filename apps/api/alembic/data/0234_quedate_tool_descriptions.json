  "quedate.my_listings": {
    "description": "The Quédate listings of the person you are talking to, with their id, status and price. Only theirs. Use it to find the listing_id before adding photos, sending it to review or hiding it.",
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "description": "Sin argumentos.",
      "properties": {},
      "title": "_Empty",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "MyListingBrief": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "price": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Price"
            },
            "status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Status"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Title"
            }
          },
          "required": [
            "id"
          ],
          "title": "MyListingBrief",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/MyListingBrief"
          },
          "title": "Items",
          "type": "array"
        },
        "linked": {
          "title": "Linked",
          "type": "boolean"
        },
        "next_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Step"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "linked"
      ],
      "title": "MyListingsOutput",
      "type": "object"
    },
    "read_only": true,
    "side_effects": []
  },
  "quedate.quote_stay": {
    "description": "Price a stay in a Quédate listing: total in USD and VES with the BCV rate. If the dates are taken or the guests exceed capacity, available=false with Quédate's message. The listing_id comes from quedate.search_listings.",
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "guests": {
          "maximum": 50,
          "minimum": 1,
          "title": "Guests",
          "type": "integer"
        },
        "listing_id": {
          "description": "Id del alojamiento, de quedate.search_listings. Nunca lo inventes.",
          "maxLength": 64,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        }
      },
      "required": [
        "listing_id",
        "check_in",
        "check_out",
        "guests"
      ],
      "title": "QuoteStayInput",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "bcv_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bcv Rate"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "nights": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nights"
        },
        "total_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Usd"
        },
        "total_ves": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Ves"
        }
      },
      "required": [
        "available"
      ],
      "title": "QuoteStayOutput",
      "type": "object"
    },
    "read_only": true,
    "side_effects": []
  },
