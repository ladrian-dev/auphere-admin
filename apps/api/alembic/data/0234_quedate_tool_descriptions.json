{
  "quedate.add_listing_photos": {
    "description": "Upload to a listing of this key the photos chosen by photo_id from quedate.recent_photos of this conversation (1 to 20). Photos cannot be removed later. If you do not have its listing_id from this same turn, find it with quedate.list_listings first.",
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "description": "Id del anuncio. Si no lo devolvió una herramienta en este mismo turno, búscalo con quedate.my_listings (los de la persona) o quedate.list_listings (equipo); nunca lo inventes.",
          "maxLength": 64,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "photo_ids": {
          "description": "De quedate.recent_photos.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Photo Ids",
          "type": "array"
        }
      },
      "required": [
        "listing_id",
        "photo_ids"
      ],
      "title": "ListingPhotosInput",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "total_photos": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Photos"
        }
      },
      "required": [
        "listing_id"
      ],
      "title": "PhotosOutput",
      "type": "object"
    },
    "read_only": false,
    "side_effects": [
      "mutates_db"
    ]
  },
