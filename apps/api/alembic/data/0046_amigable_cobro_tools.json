{
 "billing.apply_discount": {
  "description": "Aplica un descuento porcentual sobre el saldo pendiente de una o varias cuentas. Si el saldo queda en cero la cuenta pasa a PAID automáticamente. SOLO tras confirmación explícita del admin (cuentas + porcentaje).",
  "destructive": true,
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "percentage": {
     "description": "Porcentaje de descuento sobre el saldo pendiente.",
     "exclusiveMinimum": 0,
     "maximum": 100,
     "title": "Percentage",
     "type": "number"
    },
    "transaction_ids": {
     "description": "IDs de las cuentas a descontar.",
     "items": {
      "type": "integer"
     },
     "maxItems": 50,
     "minItems": 1,
     "title": "Transaction Ids",
     "type": "array"
    }
   },
   "required": [
    "transaction_ids",
    "percentage"
   ],
   "title": "ApplyDiscountInput",
   "type": "object"
  },
  "output_schema": {
   "$defs": {
    "DebtRecord": {
     "additionalProperties": false,
     "description": "One accounts-receivable record from Amigable Cobro.",
     "properties": {
      "balance": {
       "description": "Saldo pendiente (total_amount - paid_amount).",
       "title": "Balance",
       "type": "number"
      },
      "client_document": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Cédula o RIF del deudor.",
       "title": "Client Document"
      },
      "client_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Nombre del deudor.",
       "title": "Client Name"
      },
      "client_phone": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Teléfono del deudor (E.164).",
       "title": "Client Phone"
      },
      "created_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Fecha de creación (ISO 8601).",
       "title": "Created At"
      },
      "due_date": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Fecha de vencimiento (ISO 8601) o null.",
       "title": "Due Date"
      },
      "id": {
       "description": "ID interno de la cuenta por cobrar en Amigable Cobro.",
       "title": "Id",
       "type": "integer"
      },
      "paid_amount": {
       "description": "Monto pagado hasta ahora.",
       "title": "Paid Amount",
       "type": "number"
      },
      "status": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Estado de la cuenta (ej. PENDING).",
       "title": "Status"
      },
      "total_amount": {
       "description": "Monto total de la deuda.",
       "title": "Total Amount",
       "type": "number"
      }
     },
     "required": [
      "id",
      "total_amount",
      "paid_amount",
      "balance"
     ],
     "title": "DebtRecord",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "account": {
     "anyOf": [
      {
       "$ref": "#/$defs/DebtRecord"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "La cuenta después del cambio, si la API la devuelve."
    },
    "message": {
     "description": "Mensaje de resultado de la plataforma.",
     "title": "Message",
     "type": "string"
    },
    "ok": {
     "description": "True si la operación se aplicó en Amigable Cobro.",
     "title": "Ok",
     "type": "boolean"
    }
   },
   "required": [
    "ok",
    "message"
   ],
   "title": "WriteResultOutput",
   "type": "object"
  },
  "read_only": false,
  "side_effects": [
   "mutates_db"
  ]
 },
 "billing.create_account": {
