# Copy to .env.local for a dev client against something other than the local
# stack. Without these, a dev build talks to the machine it was built on
# (10.0.2.2 on the Android emulator, localhost on the iOS simulator).
# EXPO_PUBLIC_API_URL=https://api.staging.auphere.com
# EXPO_PUBLIC_CONSOLE_URL=https://console.staging.auphere.com
