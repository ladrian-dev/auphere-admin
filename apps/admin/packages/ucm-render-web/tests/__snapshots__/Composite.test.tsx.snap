exports[`Composite (via UCMRenderer) > snapshot 1`] = `"<div style="display: flex; flex-direction: column; gap: 8px;" data-ucm-type="composite" data-ucm-message-id="msg_comp_001"><div style="background: rgb(255, 255, 255); border: 1px solid rgb(227, 227, 227); border-radius: 12px; padding: 12px 14px; color: rgb(17, 17, 17); font-size: 14px; line-height: 1.45; max-width: 540px; white-space: pre-wrap;" role="article" aria-label="agent message" data-ucm-type="text" data-ucm-message-id="msg_comp_001_a">Hola</div><div style="background: rgb(255, 255, 255); border: 1px solid rgb(227, 227, 227); border-radius: 12px; padding: 12px 14px; color: rgb(17, 17, 17); font-size: 14px; line-height: 1.45; max-width: 540px;" data-ucm-type="quick_replies" data-ucm-message-id="msg_comp_001_b"><div id="qr-msg_comp_001_b-label" style="margin-bottom: 8px;">¿Continuamos?</div><div role="group" aria-labelledby="qr-msg_comp_001_b-label" style="display: flex; gap: 8px; flex-wrap: wrap;"><button type="button" data-qr-btn="true" aria-label="Sí" style="appearance: none; border: 1px solid rgb(45, 108, 223); background: rgb(255, 255, 255); color: rgb(45, 108, 223); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 500; cursor: pointer;">Sí</button><button type="button" data-qr-btn="true" aria-label="No" style="appearance: none; border: 1px solid rgb(45, 108, 223); background: rgb(255, 255, 255); color: rgb(45, 108, 223); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 500; cursor: pointer;">No</button></div></div></div>"`;
