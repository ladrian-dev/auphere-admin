# Reuses the API + worker env vars (NEXUS_*). At minimum:
#
#   NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus
#   NEXUS_REDIS_URL=redis://localhost:6379/0
#   NEXUS_ADMIN_TOKEN=...   # same Bearer the qa-api accepts
#
# Operator IDs are sent per-request via the X-Operator-Id header.
# Better Auth (Block G) will replace the static admin token with
# session-derived identity.
