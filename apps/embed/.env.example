# Nexus API base URL (the /v1/embed surface).
NEXT_PUBLIC_NEXUS_API_URL=http://localhost:8000

# Meta Embedded Signup (public identifiers — the secrets live in the API).
# App ID of the Auphere Meta app and the WhatsApp Embedded Signup
# configuration ID for the Cloud API flow. Required for /signup.
NEXT_PUBLIC_META_APP_ID=957213733862330
NEXT_PUBLIC_META_CONFIG_ID_WA_CLOUD_API=1976547999669619
# Optional: Coexistence flow configuration + Graph version override.
# NEXT_PUBLIC_META_CONFIG_ID_WA_COEXISTENCE=27787800820807899
# NEXT_PUBLIC_META_GRAPH_API_VERSION=v22.0
