# ─── Sitio ──────────────────────────────────────────────────────────────────
# URL pública (metadata, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3120

# Modo demostración: la entrega de leads se simula y la confirmación lo dice.
# También se activa solo si falta RESEND_API_KEY.
NEXT_PUBLIC_DEMO_MODE=true

# Analítica: noop (defecto) | console | plausible
NEXT_PUBLIC_ANALYTICS=console
# Solo si NEXT_PUBLIC_ANALYTICS=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Base de leads: Supabase (solo servidor; NUNCA con prefijo NEXT_PUBLIC_) ─
# Crear proyecto en supabase.com, ejecutar supabase/migrations/0001_leads.sql y copiar:
SUPABASE_URL=
# Service role key (Project Settings → API). Nunca en el cliente ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Copia a Google Sheets vía webhook de n8n (solo servidor, opcional) ─────
# URL https del webhook de n8n que añade una fila en la hoja. Vacío = sin copia.
LEADS_WEBHOOK_URL=
# Secreto que el servidor manda en la cabecera X-Leads-Secret y n8n comprueba.
LEADS_WEBHOOK_SECRET=

# ─── Aviso por correo (solo servidor) ────────────────────────────────────────
RESEND_API_KEY=
# Destinos del correo con cada lead, separados por comas (Amacrux y Auphere). TODO_COMERCIAL: validar direcciones.
LEADS_TO=
# Remitente verificado en Resend, p. ej. "Diagnóstico Amacrux <diagnostico@amacrux.com>"
LEADS_FROM=
