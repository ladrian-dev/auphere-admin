# ─── Sitio ──────────────────────────────────────────────────────────────────
# URL pública (metadata, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3120

# Modo demostración: la entrega de leads se simula y la confirmación lo dice.
# Fuera de producción también se asume si falta RESEND_API_KEY; EN PRODUCCIÓN no:
# allí, sin destinos y sin esta bandera, /api/leads responde 503 en vez de fingir.
NEXT_PUBLIC_DEMO_MODE=true

# Analítica: noop (defecto) | console | plausible
NEXT_PUBLIC_ANALYTICS=console
# Solo si NEXT_PUBLIC_ANALYTICS=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Base de leads: Supabase — OPCIONAL, HOY APAGADA ────────────────────────
# Decisión 2026-09-17: el único destino es el correo. Dejar estas dos vacías.
# Para encenderla: crear proyecto en supabase.com, ejecutar
# supabase/migrations/0001_leads.sql y copiar:
SUPABASE_URL=
# Service role key (Project Settings → API). Nunca en el cliente ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Copia a Google Sheets vía webhook de n8n — OPCIONAL, HOY APAGADA ───────
# Ojo: el webhook es una copia, no un destino. Con solo esta variable el
# endpoint sigue en demo; hace falta correo o base para que se dispare.
# URL https del webhook de n8n que añade una fila en la hoja. Vacío = sin copia.
LEADS_WEBHOOK_URL=
# Secreto que el servidor manda en la cabecera X-Leads-Secret y n8n comprueba.
LEADS_WEBHOOK_SECRET=

# ─── Entrega por correo: ÚNICO DESTINO ACTIVO (solo servidor) ───────────────
RESEND_API_KEY=
# Destino de cada lead. Admite varias direcciones separadas por comas.
LEADS_TO=contacto+event@auphere.com
# Remitente verificado en Resend (SPF/DKIM del dominio). SOLO ASCII: Resend
# rechaza tildes en el nombre visible ("contains non-ASCII characters").
LEADS_FROM=Amacrux <diagnostico@auphere.com>
