{
  "name": "@nexus/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Partner-machine shell. The bridge is outbound-only: nothing from the internet reaches the partner's machine.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "build": "node scripts/copy-tokens.mjs && tsc -p tsconfig.build.json && vite build -c vite.app.config.ts && vite build -c vite.preload.config.ts && node scripts/copy-bar-assets.mjs",
    "start": "electron .",
    "package": "electron-builder --dir",
    "copy-tokens": "node scripts/copy-tokens.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^2.1.8"
  },
  "main": "dist/electron/main.js",
  "build": {
    "appId": "com.auphere.desktop",
    "productName": "Auphere",
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "win": null
  },
  "dependencies": {
    "@nexus/companion-ui": "workspace:*",
    "@nexus/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
