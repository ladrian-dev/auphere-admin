{
  "name": "@nexus/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Partner-machine shell. The bridge is outbound-only: nothing from the internet reaches the partner's machine. The one exception is a short-lived loopback listener on 127.0.0.1 that receives the sign-in redirect (RFC 8252); it closes when the sign-in ends.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src tests --max-warnings 0",
    "test:smoke": "playwright test smoke",
    "build": "tsc -p tsconfig.build.json && vite build -c vite.app.config.ts && vite build -c vite.preload.config.ts",
    "start": "electron .",
    "package": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "electron-builder --mac",
    "test:a11y": "playwright test a11y"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.13.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.6"
  },
  "main": "dist/electron/main.js",
  "build": {
    "appId": "com.auphere.desktop",
    "productName": "Auphere",
    "files": [
      "dist/**",
      "package.json",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": null,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.auphere.com/desktop"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@nexus/companion-ui": "workspace:*",
    "@nexus/ui": "workspace:*",
    "electron-context-menu": "5.0.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
