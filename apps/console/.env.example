# apps/console — partner console (PLAN-CONSOLE-V1)
#
# The console NEVER holds the static admin token. It mints 60-second EdDSA
# tokens per backend call with the private key below; the API holds the
# public half (NEXUS_CONSOLE_JWT_PUBLIC_KEY). Generate a pair with:
#   pnpm keys:generate

NEXUS_BACKEND_URL=http://127.0.0.1:8000
NEXUS_CONSOLE_ORIGIN=http://localhost:3110
NEXUS_CONSOLE_DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus
NEXUS_CONSOLE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please-really
BETTER_AUTH_URL=http://localhost:3110
