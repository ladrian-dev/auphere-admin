# apps/console — partner console (PLAN-CONSOLE-V1)
#
# The console NEVER holds the static admin token. It mints 60-second EdDSA
# tokens per backend call with the private key below; the API holds the
# public half (NEXUS_CONSOLE_JWT_PUBLIC_KEY). Generate a pair with:
#   pnpm keys:generate

# La consola NO tiene base de datos (ADR-032): usuarios, contraseñas y
# sesiones viven en la API (`console_auth.principals`). No hay ninguna
# variable de Postgres aquí, y ese es el punto: Vercel no tiene que
# alcanzar la Aurora privada.
NEXUS_BACKEND_URL=http://127.0.0.1:8000
NEXUS_CONSOLE_ORIGIN=http://localhost:3110
NEXUS_CONSOLE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Opcionales; los valores por defecto coinciden con los de la API.
# NEXUS_CONSOLE_JWT_ISSUER=nexus-console
# NEXUS_CONSOLE_JWT_AUDIENCE=nexus-api

# Lane channels — Meta Embedded Signup (CP-17). Same Meta app the admin
# panel uses; the config ids are the Embedded Signup configurations.
# Optional: without them the "Connect WhatsApp" button explains it is not configured.
NEXUS_META_APP_ID=
NEXUS_META_GRAPH_API_VERSION=v22.0
NEXUS_META_CONFIG_ID_WA_CLOUD_API=
NEXUS_META_CONFIG_ID_WA_COEXISTENCE=
# Lane channels — origin of the @auphere/embed widget app (CP-20).
