{
  "name": "nexus-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ui:build": "pnpm --filter @nexus/ui build",
    "ui:test": "pnpm --filter @nexus/ui test",
    "ui:lint": "pnpm --filter @nexus/ui lint",
    "ui:storybook": "pnpm --filter @nexus/ui storybook",
    "console:dev": "pnpm --filter console dev",
    "console:build": "pnpm --filter console build",
    "console:test": "pnpm --filter console test",
    "console:lint": "pnpm --filter console lint",
    "console:typecheck": "pnpm --filter console typecheck",
    "admin:dev": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build",
    "admin:test": "pnpm --filter admin test",
    "admin:lint": "pnpm --filter admin lint",
    "admin:typecheck": "pnpm --filter admin typecheck",
    "check": "pnpm -r --filter @nexus/ui --filter console --filter admin run lint && pnpm -r --filter @nexus/ui --filter console --filter admin run typecheck && pnpm -r --filter @nexus/ui --filter console --filter admin run test"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "sharp@<0.35.0": ">=0.35.0",
      "@assistant-ui/core": "0.2.2",
      "@assistant-ui/store": "0.2.10",
      "@assistant-ui/tap": "0.5.11"
    }
  }
}
