# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg

# `build/` de arriba es para Python y se traga `apps/desktop/build/`, que NO es
# un artefacto: son los entitlements del hardened runtime, o sea la lista de lo
# que la app de escritorio puede hacer saltándose una protección del sistema.
# Sin esta excepción el fichero no viaja, electron-builder usa los suyos por
# defecto y nadie se entera hasta que alguien audita un paquete firmado.
!apps/desktop/build/
!apps/desktop/build/**

# Node / Next.js
node_modules/
.next/
out/
.pnpm-store/
.turbo/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Env / secrets
.env
.env.local
.env.*.local
!.env.example

# Docker volumes
pgdata/
redis-data/

# Logs
*.log
logs/

# Excepción: la evidencia de spikes y de specs. Un README que cita un log que no
# está en el repo es una afirmación sin prueba, y la evidencia existe justamente
# para que las afirmaciones se puedan verificar sin haber estado delante.
!.specify/assessments/**/evidence/**/*.log
!.specify/assessments/**/evidence/**/*.jsonl
!specs/**/evidence/**/*.log
!specs/**/evidence/**/*.jsonl

# Local artifacts
tmp/
.local/

# Claude Code workspace (agents, skills, rules, instructions)
.claude/
CLAUDE.md
**/CLAUDE.md
.claude.json
.claude.local.json
.vercel

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/terraform/backend.hcl
.envrc
storybook-static/
*.tsbuildinfo

# Excepción a `*.log` de arriba: la salida cruda de un spike es la evidencia que
# hace verificable una evaluación, y `.specify/assessments/<slug>/evidence/` es el
# sitio que el método le da. Acotado a ahí: ningún log de ejecución del producto
# entra por esta puerta.
!.specify/assessments/**/evidence/*.log

# Material de firma — NUNCA en el repositorio.
# Añadido el 2026-09-14 al comprobar que `git check-ignore cert.p12` no lo
# rechazaba: una clave privada de firma en la historia de git no se borra, se
# revoca — y revocar un Developer ID deja sin arrancar las apps ya instaladas.
*.p12
*.pfx
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.keychain
*.keychain-db

# Informes de seguridad de /cso. Se quedan en la máquina: contienen el mapa de
# la superficie de ataque y las rutas de cada hallazgo, que es justo el guion
# que alguien querría para atacar esto.
.gstack/

# Playwright (spec 010): humo del binario y revision de accesibilidad
apps/desktop/test-results/
apps/desktop/playwright-report/
