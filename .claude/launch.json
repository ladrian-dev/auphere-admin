{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/api && if [ -f .env.local ]; then set -a; . ./.env.local; set +a; fi && exec uv run uvicorn nexus_api.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir src"
      ],
      "port": 8000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/admin",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "console",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/console",
        "dev"
      ],
      "port": 3110
    },
    {
      "name": "amacrux-event",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/amacrux-event",
        "dev"
      ],
      "port": 3120
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "packages/ui",
        "exec",
        "storybook",
        "dev",
        "-p",
        "6006",
        "--no-open",
        "--ci"
      ],
      "port": 6006
    },
    {
      "name": "mobile-metro",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
