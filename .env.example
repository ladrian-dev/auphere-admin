# Copy to .env for local docker-compose overrides.
# All NEXUS_* vars are read by apps/api/src/nexus_api/config.py.

NEXUS_ENVIRONMENT=dev
NEXUS_LOG_LEVEL=INFO

# Database (matches docker-compose service)
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexus

# Redis (matches docker-compose service)
NEXUS_REDIS_URL=redis://redis:6379/0

# LiteLLM OSS proxy (product). Virtual keys are partner→sk JSON, not the master key.
# LITELLM_PROXY_API_BASE=http://litellm.nexus-staging.internal:4000
# LITELLM_PROXY_VIRTUAL_KEYS={"<partner-uuid>":"sk-..."}
