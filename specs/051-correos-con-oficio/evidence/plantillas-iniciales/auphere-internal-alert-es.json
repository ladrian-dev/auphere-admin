  ],
  "html": "<!DOCTYPE html>\n<html lang=\"es\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Auphere</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F1F7F6;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#F1F7F6;opacity:0;\">{{{HEADING}}}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#F1F7F6\" style=\"background-color:#F1F7F6;\">\n<tr><td align=\"center\" style=\"padding-top:32px;padding-bottom:32px;padding-left:12px;padding-right:12px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"max-width:600px;background-color:#FFFFFF;border-width:1px;border-style:solid;border-color:#E4ECEA;border-radius:8px;\">\n<tr><td style=\"padding-top:36px;padding-right:36px;padding-bottom:8px;padding-left:36px;\">\n<img src=\"https://www.auphere.com/brand/auphere-logo.png\" width=\"132\" height=\"34\" alt=\"Auphere\" border=\"0\" style=\"display:block;width:132px;height:34px;border:0;outline:none;text-decoration:none;\">\n</td></tr>\n<tr><td style=\"padding-top:20px;padding-right:36px;padding-bottom:28px;padding-left:36px;\">\n<p style=\"margin-top:0;margin-bottom:8px;font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;line-height:16px;color:#03624C;\"><strong>Aviso interno</strong></p>\n<h1 style=\"margin-top:0;margin-bottom:20px;font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:24px;line-height:31px;font-weight:700;color:#0D0F01;\">{{{HEADING}}}</h1>\n<p style=\"margin-top:0;margin-bottom:16px;font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:24px;color:#0D0F01;\">{{{DETAIL}}}</p>\n<p style=\"margin-top:0;margin-bottom:16px;font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;line-height:21px;color:#0B453A;\">Identificador: {{{KIND}}}</p>\n</td></tr>\n<tr><td style=\"padding-top:16px;padding-right:36px;padding-bottom:24px;padding-left:36px;border-top-width:1px;border-top-style:solid;border-top-color:#E4ECEA;\">\n<p style=\"margin-top:0;margin-bottom:0px;font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;line-height:18px;color:#0B453A;\">Aviso interno de la plataforma Auphere.</p>\n</td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr>\n</table>\n</body>\n</html>\n"
}
