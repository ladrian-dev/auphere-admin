exports[`QuickReplies > snapshot 1`] = `"<div style="background: rgb(255, 255, 255); border: 1px solid rgb(227, 227, 227); border-radius: 12px; padding: 12px 14px; color: rgb(17, 17, 17); font-size: 14px; line-height: 1.45; max-width: 540px;" data-ucm-type="quick_replies" data-ucm-message-id="msg_qr_001"><div id="qr-msg_qr_001-label" style="margin-bottom: 8px;">¿Quieres reservar ahora?</div><div role="group" aria-labelledby="qr-msg_qr_001-label" style="display: flex; gap: 8px; flex-wrap: wrap;"><button type="button" data-qr-btn="true" aria-label="Sí" style="appearance: none; border: 1px solid rgb(45, 108, 223); background: rgb(255, 255, 255); color: rgb(45, 108, 223); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 500; cursor: pointer;">Sí</button><button type="button" data-qr-btn="true" aria-label="No" style="appearance: none; border: 1px solid rgb(45, 108, 223); background: rgb(255, 255, 255); color: rgb(45, 108, 223); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 500; cursor: pointer;">No</button><button type="button" data-qr-btn="true" aria-label="Más info" style="appearance: none; border: 1px solid rgb(45, 108, 223); background: rgb(255, 255, 255); color: rgb(45, 108, 223); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 500; cursor: pointer;">Más info</button></div></div>"`;
